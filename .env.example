# Backend (FastAPI) Configuration
DATABASE_URL=sqlite:///./sports_news_ai.db
# In production with PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/sports_news_ai

# Security & Admin Authentication
ADMIN_SECRET_KEY=dev-admin-ledger-secret-key

# AI Gateway / Inference Keys (Optional for production frontier ladder)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Billing (Handbook Phase 10 — Stripe, sandbox/test mode).
# Use sk_test_/whsec_test_/price_... values from the Stripe Dashboard in test mode.
# Without these set, checkout returns a clean 503 rather than failing silently.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_MONTHLY=price_...
# STRIPE_PRICE_ID_ANNUAL=price_...
FRONTEND_BASE_URL=http://localhost:3000

# Watchlist Alerts (Handbook §18.1 — Free: daily digest, Pro: real-time).
# Without SMTP_HOST set, alert emails write to data/emails/ instead of sending
# (ConsoleEmailBackend) — the full pipeline still works end to end for local dev.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=alerts@yourdomain.com

# Frontend (Next.js) Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_ADMIN_HOST=admin.localhost:3000
